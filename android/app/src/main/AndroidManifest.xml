<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 家人手机申请编辑权限时提醒（Android 13+ 需运行时授权） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.JiQian"
        android:allowBackup="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 桌面组件：胎动 / 宫缩 / 两个开关并排 -->
        <receiver
            android:name=".widget.KickWidgetProvider"
            android:exported="true"
            android:label="@string/widget_kick_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_kick_info" />
        </receiver>

        <receiver
            android:name=".widget.ContractionWidgetProvider"
            android:exported="true"
            android:label="@string/widget_ctn_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_contraction_info" />
        </receiver>

        <receiver
            android:name=".widget.QuickWidgetProvider"
            android:exported="true"
            android:label="@string/widget_combined_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_combined_info" />
        </receiver>

        <!-- 组件按钮的落库入口（不对外暴露） -->
        <receiver
            android:name=".widget.WidgetActionReceiver"
            android:exported="false" />
    </application>
</manifest>
